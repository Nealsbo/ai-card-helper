# OpenAI-compatible API: local server or cloud endpoint. Include the API path (e.g. /v1).
# Local example: LM Studio -> Developer -> Start server.
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Optional: leave empty to auto-select a single available model or choose in the web form.
LLM_MODEL=
# Leave empty unless the inference server requires authentication.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=3500
LLM_TOKEN_LIMIT_PARAM=max_tokens
# Leave empty to use the provider default (e.g. models without temperature support).
LLM_TEMPERATURE=0.15
# json_schema for LM Studio; json_object or none for other compatible servers.
LLM_RESPONSE_FORMAT=json_schema
# Qwen + LM Studio: disable thinking so the token budget goes to the JSON answer.
# Leave empty if your server does not accept reasoning_effort.
LLM_REASONING_EFFORT=none

# Default SEO lengths in characters, including spaces. Web form overrides apply per request.
SEO_TITLE_MIN_CHARS=1
SEO_TITLE_MAX_CHARS=70
SEO_DESCRIPTION_MIN_CHARS=800
SEO_DESCRIPTION_MAX_CHARS=1200

# For cloud APIs, set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY from your provider.
# Clear LLM_REASONING_EFFORT if not supported; choose json_object / none if needed.
# Some models require LLM_TOKEN_LIMIT_PARAM=max_completion_tokens.

